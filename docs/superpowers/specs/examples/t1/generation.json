{
  "data_kind": "synthetic_review_data",
  "interface_version": "0.1",
  "constraint_sets": [
    {
      "constraint_set_id": "t1-online-01",
      "frame": {"id": "plate-xyz", "origin_mm": [0, 0, 0], "axes": {"x": [1, 0, 0], "y": [0, 1, 0], "z": [0, 0, 1]}},
      "selectors": {
        "body": {"kind": "solid", "expected_count": 1, "where": {}},
        "bore": {
          "kind": "face",
          "expected_count": 1,
          "where": {
            "geometry": "CYLINDER",
            "direction": {"kind": "axis", "vector": [0, 0, 1], "max_angle_deg": 0.1}
          }
        },
        "left": {
          "kind": "face",
          "expected_count": 1,
          "where": {
            "geometry": "PLANE",
            "direction": {"kind": "normal", "vector": [1, 0, 0], "max_angle_deg": 0.1},
            "at_extreme": {"axis": "x", "side": "min", "within_mm": 0.05}
          }
        },
        "lower": {
          "kind": "face",
          "expected_count": 1,
          "where": {
            "geometry": "PLANE",
            "direction": {"kind": "normal", "vector": [0, 1, 0], "max_angle_deg": 0.1},
            "at_extreme": {"axis": "y", "side": "min", "within_mm": 0.05}
          }
        },
        "bottom": {
          "kind": "face",
          "expected_count": 1,
          "where": {
            "geometry": "PLANE",
            "direction": {"kind": "normal", "vector": [0, 0, 1], "max_angle_deg": 0.1},
            "at_extreme": {"axis": "z", "side": "min", "within_mm": 0.05}
          }
        },
        "top": {
          "kind": "face",
          "expected_count": 1,
          "where": {
            "geometry": "PLANE",
            "direction": {"kind": "normal", "vector": [0, 0, 1], "max_angle_deg": 0.1},
            "at_extreme": {"axis": "z", "side": "max", "within_mm": 0.05}
          }
        }
      },
      "derived": {
        "t1.min_clear_diameter": {
          "unit": "mm",
          "rule_id": "diameter_lower_limit",
          "depends_on": ["parameters_mm.diameter", "constraints.diameter.criterion.tolerance"]
        }
      },
      "constraints": [
        {
          "id": "length",
          "statement": "板长沿 +X",
          "source": "user_confirmed",
          "unit": "mm",
          "criterion": {"mode": "within", "value": {"param": "length"}, "tolerance": 0.01},
          "measurement": {"id": "projected_span", "args": {"target": {"selector": "body"}, "direction": [1, 0, 0]}}
        },
        {
          "id": "width",
          "statement": "板宽沿 +Y",
          "source": "user_confirmed",
          "unit": "mm",
          "criterion": {"mode": "within", "value": {"param": "width"}, "tolerance": 0.01},
          "measurement": {"id": "projected_span", "args": {"target": {"selector": "body"}, "direction": [0, 1, 0]}}
        },
        {
          "id": "thickness",
          "statement": "板厚沿 +Z",
          "source": "user_confirmed",
          "unit": "mm",
          "criterion": {"mode": "within", "value": {"param": "thickness"}, "tolerance": 0.01},
          "measurement": {"id": "projected_span", "args": {"target": {"selector": "body"}, "direction": [0, 0, 1]}}
        },
        {
          "id": "diameter",
          "statement": "沿 +Z 的通孔直径",
          "source": "user_confirmed",
          "unit": "mm",
          "criterion": {"mode": "within", "value": {"param": "diameter"}, "tolerance": 0.01},
          "measurement": {"id": "diameter", "args": {"target": {"selector": "bore"}}}
        },
        {
          "id": "hole_x",
          "statement": "孔轴线距左板边",
          "source": "user_confirmed",
          "unit": "mm",
          "criterion": {"mode": "within", "value": {"param": "hole_x"}, "tolerance": 0.01},
          "measurement": {
            "id": "axis_plane_distance",
            "args": {"target": {"selector": "bore"}, "datum": {"selector": "left"}}
          }
        },
        {
          "id": "hole_y",
          "statement": "孔轴线距下板边",
          "source": "user_confirmed",
          "unit": "mm",
          "criterion": {"mode": "within", "value": {"param": "hole_y"}, "tolerance": 0.01},
          "measurement": {
            "id": "axis_plane_distance",
            "args": {"target": {"selector": "bore"}, "datum": {"selector": "lower"}}
          }
        },
        {
          "id": "through_hole",
          "statement": "两开口邻接孔壁，且全厚度贯通无材料遮挡",
          "source": "user_confirmed",
          "unit": "bool",
          "criterion": {"mode": "is_true"},
          "measurement": {
            "id": "through_hole",
            "args": {
              "target": {"selector": "bore"},
              "entry": {"selector": "bottom"},
              "exit": {"selector": "top"},
              "min_clear_diameter": {"derived": "t1.min_clear_diameter"}
            }
          }
        }
      ]
    }
  ],
